# Supabase project credentials (safe for the browser — anon key is public by design,
# access is enforced by Row Level Security policies in supabase/schema.sql)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# The following are used ONLY by the Supabase Edge Functions (supabase/functions/ai-assistant,
# supabase/functions/admin-users) and must be configured as Supabase Edge Function secrets, NOT
# as Vercel/frontend env vars. They are never exposed to the browser.
#
#   supabase secrets set GROQ_API_KEY=gsk_...
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
#   supabase secrets set SUPABASE_URL=https://your-project-ref.supabase.co
#   supabase secrets set SITE_URL=https://your-deployed-app.vercel.app
#
# GROQ_API_KEY is a free-tier key from https://console.groq.com — the AI Assistant page's chat
# feature is dead in the water without it. It's created under whoever's personal Groq account
# signed up for it, NOT tied to this Supabase project — if that person's account/access ever
# goes away, this key can stop working even though nothing else about the app changes. Check
# whose account it's under before an ownership handoff, and swap it for one under a durable
# (company-owned) Groq account if needed.
#
# GROQ_API_KEY=gsk_...
# SUPABASE_SERVICE_ROLE_KEY=...
# SITE_URL=https://your-deployed-app.vercel.app
