# Supabase project credentials (safe for the browser — anon key is public by design,
# access is enforced by Row Level Security policies in supabase/schema.sql)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# The following are used ONLY by the Supabase Edge Function (supabase/functions/claude-assistant)
# and must be configured as Supabase Edge Function secrets, NOT as Vercel/frontend env vars.
# They are never exposed to the browser.
#
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
#   supabase secrets set SUPABASE_URL=https://your-project-ref.supabase.co
#
# ANTHROPIC_API_KEY=sk-ant-...
# SUPABASE_SERVICE_ROLE_KEY=...
